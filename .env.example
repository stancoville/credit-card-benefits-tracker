# Neon Postgres connection string.
# Production points at the `main` branch; preview and demo point at the `demo` branch.
# Never point a preview deployment at real household data (SPEC §2).
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Shows the demo banner and disables anything destructive (SPEC §2).
DEMO_MODE="false"

# Household PIN gate (SPEC §10). Required in production — a production build without both
# can't be unlocked. Leave unset locally for no gate. Never commit real values.
HOUSEHOLD_PIN=""
# Signs the unlock cookie. Generate with: openssl rand -hex 32
UNLOCK_SECRET=""
